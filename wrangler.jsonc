{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "todo-app",
  "main": "worker/index.ts",
  "compatibility_date": "2025-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "todo-db",
      "database_id": "7624493d-b867-4538-8059-b1ee09f06eb7"
    }
  ]
}
