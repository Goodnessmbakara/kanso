{
  "name": "todo-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:worker": "wrangler dev",
    "dev": "concurrently -k -p \"[{name}]\" -n \"Vite,Worker\" -c \"cyan,magenta\" \"npm run dev:frontend\" \"npm run dev:worker\"",
    "build:frontend": "vite build",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "db:migrate": "wrangler d1 execute todo-db --local --file=./migrations/0001_initial.sql",
    "db:migrate:prod": "wrangler d1 execute todo-db --remote --file=./migrations/0001_initial.sql"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "hono": "^4.7.4",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wrangler": "^4.139.0"
  }
}
